# Dashboard app URL (where users land after auth)
# Production: https://dashboard.beblocky.com — never localhost
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Auth app (login UI)
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3000

# Auth API (Go service). Public URL used by the browser. Never put an
# internal Docker hostname here: NEXT_PUBLIC_ values are inlined into the
# client bundle at `next build`, and an internal address breaks login.
# Changing any NEXT_PUBLIC_* value requires a rebuild of the image.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8080

# Server-only. Docker network address of auth-service, for example
# http://auth-api:8080. proxy.ts, route handlers, and the root layout use
# this and fall back to NEXT_PUBLIC_AUTH_SERVICE_URL. Read at container
# start, so it does not need a rebuild. Do not prefix it with NEXT_PUBLIC_.
# AUTH_SERVICE_INTERNAL_URL=http://auth-api:8080
#
# First-load JS report (webpack; production builds use Turbopack):
# ANALYZE=true pnpm exec next build --webpack
# or: pnpm analyze

# Beblocky API (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Beblocky IDE (course preview / learn)
NEXT_PUBLIC_IDE_URL=http://localhost:3001

# Learner app (wrong-role prompt from this dashboard)
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3002
